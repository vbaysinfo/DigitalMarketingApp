# ---------------------------------------------------------------------------
# AI Social Marketing Agent — environment configuration
# Copy to .env.local (dev) or set in your hosting provider. Never commit real values.
# ---------------------------------------------------------------------------

# App security (required in production)
APP_PASSWORD=change-me                 # login password for the dashboard
SESSION_SECRET=generate-a-long-random-string
ENCRYPTION_KEY=generate-another-long-random-string   # encrypts OAuth tokens at rest (AES-256-GCM)
APP_BASE_URL=https://social.example.com              # public HTTPS URL; OAuth redirect URLs are derived from it
CRON_SECRET=generate-a-random-string                 # for GET /api/cron/tick (external scheduler)

# Storage
DATA_DIR=./data                        # SQLite database + media files (use a persistent volume)

# AI (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5                 # optional override
AI_EFFORT=medium                       # low | medium | high | xhigh | max
AI_REFUSAL_FALLBACKS=on                # server-side refusal fallbacks ("off" to disable)
GENERATION_CONCURRENCY=2

# Video rendering (bundled ffmpeg-static is used when unset)
FFMPEG_PATH=

# Scheduler (the in-process scheduler runs every minute on a Node server)
DISABLE_INTERNAL_SCHEDULER=false

# LinkedIn — https://www.linkedin.com/developers/apps
# Products: "Sign In with LinkedIn using OpenID Connect", "Share on LinkedIn",
# and "Community Management API" for Company Page posting.
# Redirect URL: ${APP_BASE_URL}/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202608            # YYYYMM, update when LinkedIn sunsets a version
LINKEDIN_ENABLE_ORGANIZATIONS=true     # request Company Page scopes

# Meta (Facebook Pages + Instagram) — https://developers.facebook.com/apps
# Redirect URLs: ${APP_BASE_URL}/api/oauth/facebook/callback and /api/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled)
# Redirect URL: ${APP_BASE_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_PRIVACY=public                 # public | unlisted | private
YOUTUBE_CATEGORY_ID=22

# X / Twitter (OAuth 2.0, confidential client) — Redirect: ${APP_BASE_URL}/api/oauth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok (Content Posting API) — Redirect: ${APP_BASE_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest (API v5) — Redirect: ${APP_BASE_URL}/api/oauth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
